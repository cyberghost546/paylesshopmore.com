# Copy to .env for local development. .env is gitignored — never commit secrets.
#
#   cp .env.example .env

# Turns on debug pages, permissive CORS defaults and a throwaway secret key.
# NEVER set this in production: debug pages expose source code and settings.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off. Generate one with:
#   .venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated. Required in production.
# DJANGO_ALLOWED_HOSTS=paylesshopmore.com,www.paylesshopmore.com

# Origins allowed to call the API with cookies. Defaults to the Vite dev
# server while DEBUG is on.
DJANGO_CORS_ORIGINS=https://paylesshopmore.com
DJANGO_CSRF_ORIGINS=https://paylesshopmore.com

# Vercel gives every preview deployment its own hostname, so no list written
# in advance can name them. A regex can. Anchor it, escape the dots, and name
# your own project — a careless pattern here is an open API.
#
# Anchor it on your Vercel TEAM slug as well as the project name. Anybody can
# create a Vercel project called "<your-project>-anything" and get
# https://<your-project>-anything.vercel.app, so a pattern naming only the
# project prefix lets a stranger's site call this API with credentials.
# Preview URLs look like https://<project>-<hash>-<team>.vercel.app:
# DJANGO_CORS_ORIGIN_REGEX=^https://pay-les-shop-more-[a-z0-9]+-<your-team-slug>\.vercel\.app$

# How many proxies append to X-Forwarded-For before a request reaches Django.
# Every per-address rate limit depends on it; see NUM_PROXIES in settings.py
# for how to count them. Unset, a client can dodge those limits by sending
# its own X-Forwarded-For. With DEBUG off, startup logs warning plsm.W001
# until it is set. Find the right number by opening /api/staff/request-origin/
# as an admin, both through the site and directly on the backend's domain.
# DJANGO_NUM_PROXIES=

# Behind Vercel the visitor's real address is not in X-Forwarded-For but in
# X-Vercel-Forwarded-For. Name that header here and set DJANGO_NUM_PROXIES=1.
# See config/client_ip.py.
# DJANGO_CLIENT_IP_HEADER=X-Vercel-Forwarded-For

# Site-wide ceilings, per hour, on what anonymous visitors can create, counted
# for everybody together so a spoofed address cannot dodge them (see
# config/abuse.py). Defaults shown; raise them if real traffic ever meets them.
# DJANGO_SITE_LIMIT_SIGNUP=100
# DJANGO_SITE_LIMIT_CONTACT=200
# DJANGO_SITE_LIMIT_QUOTE=200
# DJANGO_SITE_LIMIT_BOOKING=200

# The largest request the public upload endpoints (booking, quote, contact,
# signup) accept, files included, in bytes. Default 25 MB. Staff and warehouse
# uploads are not limited by this. See config/request_limits.py.
# DJANGO_PUBLIC_REQUEST_MAX_BYTES=26214400

# Cookies. Leave this OFF, which is the default and means SameSite=Lax.
#
# It is only correct to turn on if the site and the API really are on
# different origins. The deployment this project is set up for avoids that:
# Vercel rewrites /api to the API, so the browser sees one origin and the
# session cookie is first-party. Turning this on sets SameSite=None, which
# Safari discards and Firefox partitions — customers using either would not
# stay signed in.
DJANGO_CROSS_SITE_COOKIES=0

# How long a signed-in session lasts, in seconds. Default is fourteen days.
DJANGO_SESSION_COOKIE_AGE=1209600

# --- Database ---------------------------------------------------------------
# Three ways in, tried in this order. Leave all of them unset for SQLite,
# which is fine for development and refused outright when DJANGO_DEBUG is off.
#
# 1. One URL, which is what Neon, Supabase, Railway, Render and Heroku hand
#    out. Percent-encode any @ / : or # in the password.
# DATABASE_URL=postgres://user:password@host:5432/paylesshopmore
#
# 2. Or the separate variables, which are clearer in a compose file.
# POSTGRES_DB=paylesshopmore
# POSTGRES_USER=paylesshopmore
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# How long a database connection is kept open between requests. 60 is right
# for a long-lived process. Set it to 0 behind a transaction-mode pooler
# (PgBouncer, Supabase port 6543) or on anything serverless, where a reused
# connection is never reused and a burst exhausts the pool.
DJANGO_CONN_MAX_AGE=60

# Require TLS to the database. On by default whenever DJANGO_DEBUG is off.
DJANGO_DB_SSL_REQUIRE=1

# --- File storage -----------------------------------------------------------
# Where invoice PDFs and quote attachments are kept.
#
# Unset means the local filesystem under backend/media, which is correct for
# development and for a host with a persistent disk. It is wrong anywhere the
# process can be replaced without warning, or wherever more than one web
# process runs: an invoice written by one of them is simply not there when
# another is asked for it.
#
# Setting the bucket name switches to any S3-compatible store. Requires
# requirements-prod.txt, which brings django-storages and boto3.
#
# The bucket must be PRIVATE. Every file in it is served by a Django view
# that checks who is asking; a public bucket makes that check bypassable by
# anyone who can guess a filename.
# AWS_STORAGE_BUCKET_NAME=paylesshopmore-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto


# Leave unset for Amazon S3 itself. Required for everyone else, e.g.
#   Cloudflare R2  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2   https://s3.<region>.backblazeb2.com
#   DO Spaces      https://<region>.digitaloceanspaces.com
# AWS_S3_ENDPOINT_URL=
# 'virtual' suits S3 and R2; some providers and MinIO need 'path'.
# AWS_S3_ADDRESSING_STYLE=virtual

# --- E-mail -----------------------------------------------------------------
# Used for password-reset links. While DJANGO_DEBUG is on the message is
# printed to the console the server runs in, so a reset can be followed
# end to end without an SMTP server or a real inbox.
#
# In production these are required, or no reset mail ever arrives.
#
# For Hostnet: the host and port below, and log in with the FULL mailbox
# address (e.g. app@paylesshopmore.com) - not the server name. The sender in
# DJANGO_FROM_EMAIL must be that mailbox or an alias of it, or Hostnet may
# refuse to send. The password goes in .env (local) or the host's settings
# (Railway), never in this file.
EMAIL_HOST=smtp.hostnet.nl
EMAIL_PORT=587
EMAIL_HOST_USER=app@paylesshopmore.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DJANGO_FROM_EMAIL=PayLesShopMore <noreply@paylesshopmore.com>

# Where the React app is served. The reset link is opened from a mail client,
# so it has to be absolute. Defaults to the Vite dev server.
DJANGO_FRONTEND_URL=https://paylesshopmore.com

# How long a reset link stays valid, in seconds. Default one hour.
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# How long a warehouse worker's four-digit sign-in code works, in minutes.
# Default 15. Keep it short: a four-digit code is only as safe as the time
# anybody has to guess it in (and each code is also dead after five guesses).
WAREHOUSE_CODE_MINUTES=15

# Whether a new warehouse sign-in code is shown on the Workers page instead of
# being e-mailed. "auto" (default): only while the site cannot send real mail
# (no EMAIL_HOST). It goes back to e-mail by itself once EMAIL_HOST is set. "1"
# always, "0" never. While shown, the admin who sent it could use it
# themselves; each such code is marked shown_on_screen.
WAREHOUSE_CODE_ON_SCREEN=auto

# How long a warehouse worker who signed in with a code may sit idle before the
# session ends, in minutes. Default 30. The floor shares devices, so a forgotten
# log-out should not leave the next person working as somebody else. It slides:
# anybody who is working is never cut off. "Idle" means nobody did anything:
# pages that refresh themselves on a timer do not count. Everyone else keeps
# the two-week session (DJANGO_SESSION_COOKIE_AGE). The minimum is 1: Django
# reads 0 as "until the browser closes", so anything lower is raised to 1.
WAREHOUSE_SESSION_IDLE_MINUTES=30

# ---- Sensitive admin actions ----------------------------------------------------
# Minutes a typed password counts as "it is really me" before changing a role,
# deleting an account, making an API key... (accounts/reauth.py).
# DJANGO_REAUTH_WINDOW_MINUTES=10

# ---- HSTS (production only) ------------------------------------------------------
# Off until EVERY subdomain of the live domain works over HTTPS: both reach
# beyond this one host, and preload takes months to undo.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false

# ---- Two-factor sign-in (docs/TWO-FACTOR.md) --------------------------------
# The admin turns it on and off on the dashboard's Security page; it starts
# "disabled". These only shape the environment around that choice.
#
# Encrypts the authenticator secrets in the database. SET IN PRODUCTION AND
# NEVER LOSE IT. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DJANGO_TWO_FACTOR_ENCRYPTION_KEYS=
# The least strict mode allowed, e.g. required_admins on the live site.
# DJANGO_TWO_FACTOR_MINIMUM_MODE=
# Development only: switch two-factor off on this computer. Ignored when
# DJANGO_DEBUG is off.
# DJANGO_TWO_FACTOR_FORCE_DISABLED=false

# ---- Staff sign-in security (accounts/staff_sessions.py, config/admin_access.py)
# Minutes an admin or office session may sit unused before it ends.
# DJANGO_STAFF_IDLE_MINUTES=60
# Django's /admin/ only from these addresses or ranges (comma-separated).
# Empty = from anywhere. Needs DJANGO_NUM_PROXIES. See config/admin_access.py.
# DJANGO_ADMIN_ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# The location a received package gets when none is set (upper case).
# Leave empty to switch it off.
WAREHOUSE_DEFAULT_LOCATION=PAYLESSHOPMORE
# The warehouses offered on the package page as one button each
# (comma-separated, upper case).
WAREHOUSE_LOCATIONS=PAYLESSHOPMORE

# --- Background tasks -------------------------------------------------------
# No broker means invoice rendering happens inline, in the request that
# approved the invoice. Fine for development; set this in production and run
# a worker beside the web process:
#
#   celery -A config worker --loglevel=info
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Cache ------------------------------------------------------------------
# Shared cache. Without it each worker process keeps its own, and the API rate
# limits become the configured rate multiplied by the number of processes.
REDIS_URL=redis://localhost:6379/1

# --- Logging and error reporting --------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Everything is written to stdout.
DJANGO_LOG_LEVEL=INFO

# Optional. With no DSN nothing is sent and sentry-sdk is not even imported.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Transport security -----------------------------------------------------
# How long browsers should refuse plain HTTP, in seconds. Start small while
# testing: this is hard to undo once browsers have cached it. Default one year.
DJANGO_HSTS_SECONDS=31536000

# --- Courier tracking (backend/tracking/, docs/TRACKING.md) -----------------
# The 17TRACK "security key" (https://api.17track.net -> Settings). Unset =
# no automatic courier updates; staff add them by hand. Never put this in the
# frontend: it is used by the server only.
# SEVENTEEN_TRACK_API_KEY=
# SEVENTEEN_TRACK_API_URL=https://api.17track.net/track/v2.2
# Hours between automatic checks of one shipment (the webhook is faster).
# TRACKING_POLL_HOURS=6
# Development only (ignored unless DJANGO_DEBUG=1): made-up tracking for
# numbers starting with MOCK, e.g. MOCK-TRANSIT-1. Never on the live site.
# TRACKING_MOCK_PROVIDER=1
#
# --- Carriers' own tracking APIs (docs/CARRIER_INTEGRATIONS.md) -------------
# Optional. Without them 17TRACK (above) or manual updates are used. Setting a
# key does not switch anything on: an admin still has to run "Test
# connection" and enable the carrier on Dashboard -> Tracking integrations.
# Server side only - never in the frontend, never in the database.
# DHL Shipment Tracking - Unified (built; https://developer.dhl.com):
# DHL_API_KEY=
# PostNL (prepared; only for parcels sent with your own PostNL contract):
# POSTNL_API_KEY=
# POSTNL_CUSTOMER_NUMBER=
# POSTNL_CUSTOMER_CODE=
# DPD Netherlands (prepared; business customers only):
# DPD_DELIS_ID=
# DPD_PASSWORD=
# DPD_API_URL=
# Amazon Shipping (prepared; only for Amazon Shipping customers):
# AMAZON_SHIPPING_CLIENT_ID=
# AMAZON_SHIPPING_CLIENT_SECRET=
# AMAZON_SHIPPING_REFRESH_TOKEN=
# FedEx Track API (prepared; https://developer.fedex.com):
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=

# ---------------------------------------------------------------------------
# AI document reading (docs/DOCUMENT_REVIEW.md)
# ---------------------------------------------------------------------------
# The OpenAI API key (platform.openai.com). Secret: put it in .env or the
# host's settings, never in this file. Without it nothing is read by AI.
# Also used by the chat assistant and the office's AI helpers below.
# OPENAI_API_KEY=
# The model that reads documents. Default: gpt-5.5.
# DOCUMENT_AI_MODEL=gpt-5.5
# Read customer uploads (receipts, booking attachments) by themselves.
# Default: on when OPENAI_API_KEY is set. 0 = only staff uploads and e-mails.
# DOCUMENT_AI_AUTO=1

# ---------------------------------------------------------------------------
# AI assistant: the website chat, "Write with AI", message sorting, the daily
# summary and the customs check (backend/assistant, enquiries/sorting.py,
# staff/daily_summary.py, staff/customs_check.py). Uses OPENAI_API_KEY above.
# ---------------------------------------------------------------------------
# Show the chat on the website. Default: on when OPENAI_API_KEY is set.
# ASSISTANT_ENABLED=1
# The model for the chat and the office helpers. Default: DOCUMENT_AI_MODEL.
# A smaller, cheaper model is fine here.
# ASSISTANT_AI_MODEL=gpt-5.5
# How hard a reasoning model thinks before answering. Default: low (quick).
# Leave empty for a model that does not reason.
# ASSISTANT_AI_REASONING=low

# ---------------------------------------------------------------------------
# Backups and error monitoring (docs/BACKUPS.md)
# ---------------------------------------------------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=
# Where customers' answers to dashboard replies go (the From address is noreply).
# DJANGO_REPLY_TO_EMAIL=info@paylesshopmore.com
